# 复制为 .env.local 并填入真实值（.env.local 不会被打包/提交）

# ── 必填 ──────────────────────────────
# Supabase（账号系统 + 历史行程；缺失时仍可游客生成，但无法登录/保存）
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
# 分享/管理后台用的服务端密钥（service_role，切勿暴露到前端）
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# 通义千问 DashScope（核心：方案生成与对话改方案）
DASHSCOPE_API_KEY=sk-xxx...

# 高德地图（POI/地理编码/驾车路线/天气；服务端用 AMAP_KEY，前端地图用 NEXT_PUBLIC_AMAP_KEY）
AMAP_KEY=xxx
NEXT_PUBLIC_AMAP_KEY=xxx
NEXT_PUBLIC_AMAP_SECURITY_JSCODE=xxx

# ── 可选 ──────────────────────────────
# Tavily 联网检索（住宿优劣势归纳）；不填则仅用模型常识
TAVILY_API_KEY=tvly-xxx
# 设为 1 跳过住宿联网检索，加快生成
TRAVEL_SKIP_HOTEL_WEB=

# 模型覆盖（默认 fast/standard=qwen-turbo，chat=qwen-plus）
QWEN_MODEL_FAST=
QWEN_MODEL_STANDARD=
QWEN_MODEL_CHAT=

# 游客免费生成次数（默认 3）
GUEST_FREE_USES=
# 管理后台白名单邮箱，逗号分隔
ADMIN_EMAILS=
